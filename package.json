  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "pi", "markdown", "terminal", "pills"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlindquist/pi-emphasis.git"
  },
