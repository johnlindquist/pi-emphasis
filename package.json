    "extensions": ["./index.ts"]
  },
  "files": ["index.ts", "README.md", "LICENSE"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "1.5.2",
    "bun-types": "^1.4.4",
    "marked": "18.0.11",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && bun test"
  }
}
